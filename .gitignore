# Build outputs and temporary OpenWrt trees
/openwrt/
/build/
/build_dir/
/staging_dir/
/tmp/
/dl/
/bin/
/logs/
*.log
*.tmp

# Firmware images and large artifacts; publish releases through GitHub Releases
/releases/*
!/releases/.gitkeep
*.img
*.img.gz
*.bin
*.itb
*.manifest
*.buildinfo
*.ova
*.iso
*.pcap
*.pcapng

# Local/private material
_private*/
*password*
*secret*
*.key
*.pem
*.ovpn
*.conf.private
*.bak
.DS_Store
Thumbs.db
